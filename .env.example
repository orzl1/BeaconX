# BeaconX environment template.
#
# Copy to .env for docker compose, or export the variables when running the
# binary directly. Every variable is optional except the database DSN.

# PostgreSQL connection used by the service.
BEACONX_DB_DSN=postgres://beaconx:beaconx@127.0.0.1:5432/beaconx?sslmode=disable

# HTTP listen address.
BEACONX_ADDR=:8787

# State directory (sessions, evidence, traffic, skills).
BEACONX_HOME=./data

# Single-tenant default. Multi-tenant isolation is a later milestone; the
# identifier is reserved from day one.
BEACONX_TENANT_DEFAULT_ID=1

# Logging.
BEACONX_LOG_LEVEL=info
BEACONX_LOG_FORMAT=json

# Optional: path to a JSON config file.
# BEACONX_CONFIG=./config.json
