# BeaconX 环境变量模板。
#
# 复制为 .env 供 docker compose 使用；直接运行二进制时导出这些变量即可。
# 注意：docker compose 只使用其中被 compose 文件引用的变量；其余变量在容器
# 部署时请通过 config.json 或补充 compose 的 environment 生效。
# 除数据库 DSN 外，所有变量均为可选项；值为空时视为未设置。

# 服务使用的 PostgreSQL 连接。
BEACONX_DB_DSN=postgres://beaconx:beaconx@127.0.0.1:5432/beaconx?sslmode=disable

# 数据库连接池上限与保底连接数。
BEACONX_DB_MAX_CONNS=10
BEACONX_DB_MIN_CONNS=1

# HTTP 监听地址、请求上下文超时与优雅退出等待上限。
BEACONX_ADDR=:6969
BEACONX_REQUEST_TIMEOUT=30s
BEACONX_SHUTDOWN_TIMEOUT=15s

# 状态目录（会话、证据、流量、技能）。
BEACONX_HOME=./data

# 单租户默认值。多租户隔离属于后续里程碑；该标识从第一天起就已预留。
BEACONX_TENANT_DEFAULT_ID=1

# 日志。
BEACONX_LOG_LEVEL=info
BEACONX_LOG_FORMAT=json

# 任务运行时：并发上限、规划/执行轮询间隔、动作租约时长与续约间隔。
BEACONX_MAX_CONCURRENT=2
BEACONX_PLANNER_INTERVAL=2s
BEACONX_WORKER_INTERVAL=200ms
BEACONX_LEASE_TTL=30s
BEACONX_HEARTBEAT_INTERVAL=10s

# 管理接口令牌。留空时启动会生成临时令牌并打印到日志（仅当前进程有效）。
# 生产部署应显式配置一个足够长的随机令牌。
# BEACONX_ADMIN_TOKEN=

# LLM 规划（OpenAI 兼容端点）。base_url 与 model 同时非空才会启用 AI；
# 不配置时运行时为 idle（空规划器/执行器）。
# 密钥只放本地 .env 或环境变量，不要提交到仓库；留空时不会发送 Authorization 头。
# 故障转移候选写在 config.json 的 llm.fallbacks 中（没有对应环境变量）。
# BEACONX_LLM_BASE_URL=https://api.deepseek.com
# BEACONX_LLM_MODEL=deepseek-flash
# BEACONX_LLM_API_KEY=
# BEACONX_LLM_MAX_TOKENS=2048
# BEACONX_LLM_TIMEOUT=60s
# BEACONX_LLM_MAX_RETRIES=2

# 工具策略：无规则命中时的默认裁决（allow/ask/deny）与 ask 的默认审批等待超时。
BEACONX_POLICY_DEFAULT_ACTION=ask
BEACONX_APPROVAL_TIMEOUT=60s

# 证据加密存储。dir 留空表示 <状态目录>/tenants/<tenant_id>/evidence；
# key 留空表示使用或自动生成 <状态目录>/evidence.key（0600）。
# 密钥只放本地 .env，不要提交到仓库；轮换用 POST /evidence/rotate，新密钥需更新此处并重启。
# BEACONX_EVIDENCE_DIR=
# BEACONX_EVIDENCE_KEY=

# 自更新（GitHub Release）。容器部署建议改为 false，通过重新拉取镜像升级。
BEACONX_UPDATE_ENABLED=true
BEACONX_UPDATE_REPO=orzl1/BeaconX

# 可选：JSON 配置文件路径。
# BEACONX_CONFIG=./config.json


# B6/B7/B8 功能环境变量（仅环境变量，未进 config 结构；空值视为未设置）。
# BEACONX_LLM_CAPTURE=true
# BEACONX_LLM_RETENTION_DAYS=7
# BEACONX_NOTIFY_ALLOW_PRIVATE=false
# BEACONX_SYNC_ALLOW_PRIVATE=false
# BEACONX_SYNC_RETENTION_DAYS=30
# BEACONX_SYNC_TIMEOUT=10s
# BEACONX_SYNC_MAX_BYTES=5242880
# BEACONX_SKILLS_DIR=
# BEACONX_SKILLS_KEEP_VERSIONS=5
# BEACONX_MCP_ALLOW_STDIO=false
# BEACONX_MCP_STDIO_ALLOWLIST=
# BEACONX_MCP_STDIO_DIR=
# BEACONX_WORKSPACE_QUOTA_MB=100
